{
  "name": "ai-website-clone-template",
  "version": "0.3.1",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "npm --env-file=.env run prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@base-ui/react": "^1.3.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.6.0",
    "nanoid": "^5.0.0",
    "next": "^16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.54.0",
    "shadcn": "^4.1.0",
    "sharp": "^0.33.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-table": "^8.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.32.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}